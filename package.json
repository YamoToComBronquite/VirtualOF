{
  "name": "virtualof",
  "version": "0.1.5",
  "private": true,
  "description": "A pixel-art virtual office to command AI coding agents (Claude, Codex) and watch Antigravity.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YamoToComBronquite/VirtualOF.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --import tsx server/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build:web": "vite build",
    "build:server": "esbuild server/app.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/app.mjs",
    "build": "npm run build:web && npm run build:server",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@openai/codex-sdk": "^0.164.0",
    "electron-updater": "^6.8.11",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "main": "electron/main.mjs",
  "author": "Yamo",
  "build": {
    "appId": "io.github.yamotocombronquite.virtualof",
    "productName": "VirtualOF",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-server/**",
      "electron/**",
      "build/icon.png",
      "escritorio.config.json",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "node_modules/@openai/codex-*/**",
      "node_modules/@lydell/node-pty*/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "VirtualOF",
      "artifactName": "VirtualOF-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "YamoToComBronquite",
      "repo": "VirtualOF",
      "releaseType": "release"
    }
  }
}
